# =============================================================================
# 로컬 배포를 위한 환경 변수 설정 (예시)
# 사용법: 
#   1. 이 파일을 .env.deploy로 복사
#   2. 실제 값으로 수정
#   3. source .env.deploy
# =============================================================================

# AWS 설정
export AWS_REGION=ap-southeast-2
export EKS_CLUSTER_NAME=community-eks-cluster

# Database (RDS)
export DB_HOST=your-rds-endpoint.rds.amazonaws.com
export DB_USER=admin
export DB_PASSWORD=your-secret-password
export DB_NAME=communitydb

# Read Replica (선택적)
# export READ_REPLICA_HOST=your-replica-endpoint.rds.amazonaws.com

# Redis (ElastiCache)
export REDIS_HOST=redis-cluster.cache.amazonaws.com
export REDIS_PORT=6379
# export REDIS_PASSWORD=your-redis-password

# Security Keys (랜덤 생성 권장)
# python3 -c "import secrets; print(secrets.token_urlsafe(32))" 로 생성
export JWT_SECRET_KEY=your-jwt-secret-key-here
export SESSION_SECRET_KEY=your-session-secret-key-here

# AI Service (선택적)
export GROQ_API_KEY=your-groq-api-key

# =============================================================================
# 사용 방법:
# 1. 이 파일을 .env.deploy로 복사: cp env.deploy.example .env.deploy
# 2. .env.deploy 파일에서 위 값들을 실제 값으로 수정
# 3. 터미널에서 실행: source .env.deploy
# 4. 배포 스크립트 실행: ./deploy.sh
# =============================================================================
